<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/card_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtros de Escaneamento"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tamanho mínimo (KB):"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_min_size"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/search_bg"
                    android:inputType="number"
                    android:paddingHorizontal="8dp"
                    android:text="500"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Duração mínima (segundos):"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_min_duration"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/search_bg"
                    android:inputType="number"
                    android:paddingHorizontal="8dp"
                    android:text="30"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pasta de música (opcional):"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_folder_path"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/search_bg"
                        android:paddingHorizontal="8dp"
                        android:text=""
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="12sp"
                        android:lines="1" />

                    <Button
                        android:id="@+id/btn_browse_folder"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="..."
                        android:backgroundTint="?attr/themeSurface2"
                        android:textColor="?attr/themeTextPrimary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_rescan"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:text="Reescanear Biblioteca"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/onPrimary"
                    android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_library"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biblioteca"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stat_songs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#1DB954"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Músicas"
                            android:textColor="?attr/themeTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stat_artists"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#1DB954"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Artistas"
                            android:textColor="?attr/themeTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stat_albums"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#1DB954"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Álbuns"
                            android:textColor="?attr/themeTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_toggle_theme"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:text="Alternar Tema (Claro/Escuro)"
                    android:backgroundTint="?attr/themeSurface2"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:stateListAnimator="@null" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sobre"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_version_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MP3 Player v1.0.0"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_build_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Build info"
                        android:textColor="?attr/themeTextTertiary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Toque para abrir configurações do app"
                        android:textColor="?attr/themeHint"
                    android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permissões"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_permission_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="..."
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Acesso a arquivos de áudio (MediaStore)"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Gerenciar todos os arquivos (Android 11+)"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Notificações (controle de reprodução)"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Serviço em foreground"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />

            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dispositivo"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_device_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
